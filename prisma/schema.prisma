// Vantage MOC — Prisma schema (SQLite)
//
// Enums are stored as strings because SQLite has no native enum type.
// The authoritative value lists live in src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  isAdmin      Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  memberships    SiteMembership[]
  ledMocs        Moc[]            @relation("MocLead")
  createdMocs    Moc[]            @relation("MocCreator")
  approvals      Approval[]
  auditEntries   AuditEntry[]
  notifications  Notification[]
  actionItems    ActionItem[]     @relation("ActionOwner")
  attachments    Attachment[]
  bypassLogs     BypassLogEntry[]
  checklistDone  ChecklistResponse[] @relation("ChecklistCompleter")
  checklistOwned ChecklistResponse[] @relation("ChecklistOwner")
  extensionReviews ExtensionReview[]
  addendumApprovals Addendum[]    @relation("AddendumApprover")
  createdAddenda Addendum[]       @relation("AddendumCreator")
}

model Site {
  id     String  @id @default(cuid())
  code   String  @unique // short code used in MOC numbers, e.g. "GUR"
  name   String
  active Boolean @default(true)

  memberships SiteMembership[]
  mocs        Moc[]
}

// A user's membership at a site, with zero or more functional roles.
// Roles (comma-separated SiteRole values): PROCESS_SAFETY, EHSS_MANAGER,
// PRODUCTION_MANAGER, TECHNICAL_AUTHORITY, MAINTENANCE_MANAGER, SITE_MANAGER
model SiteMembership {
  id     String @id @default(cuid())
  siteId String
  userId String
  roles  String @default("")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([siteId, userId])
}

model Moc {
  id     String @id @default(cuid())
  number String @unique // e.g. GUR-2026-0001
  siteId String

  // LEVEL1 | LEVEL2 | MOOC | BYPASS  (LEVEL2 form covers hazard levels 2-4)
  type String
  // 1-4 from the hazard assessment matrix (null for MOOC/BYPASS)
  level Int?

  // DRAFT | REVIEW | IMPLEMENTATION | HANDOVER | CLOSEOUT | ACTIVE | CLOSED | REJECTED | CANCELED
  status String @default("DRAFT")

  title  String
  leadId String

  // PERMANENT | TEMPORARY
  changeType String    @default("PERMANENT")
  startDate  DateTime?
  endDate    DateTime? // required for TEMPORARY changes / bypass expiration

  // Hazard assessment inputs (matrix from MOC training): LOW | HIGH
  degreeOfHazard String?
  significance   String?

  // Form-type-specific fields, JSON-encoded. See src/lib/forms.ts for shapes.
  formData String @default("{}")

  createdById String
  createdAt   DateTime  @default(now())
  submittedAt DateTime?
  closedAt    DateTime?

  site      Site @relation(fields: [siteId], references: [id])
  lead      User @relation("MocLead", fields: [leadId], references: [id])
  createdBy User @relation("MocCreator", fields: [createdById], references: [id])

  approvals    Approval[]
  checklists   ChecklistResponse[]
  actionItems  ActionItem[]
  attachments  Attachment[]
  auditEntries AuditEntry[]
  addenda      Addendum[]
  bypassLogs   BypassLogEntry[]
  extensions   ExtensionReview[]

  @@index([siteId, status])
  @@index([status])
}

// One required signature within a workflow stage.
model Approval {
  id    String @id @default(cuid())
  mocId String

  // Stage keys per form type — see src/lib/workflow.ts
  stage String
  // Display label of the signing function, e.g. "Process Safety", "Technical Authority (TA)"
  roleLabel String
  // SiteRole key this signature is routed by, or "MOC_LEAD" / "RELEVANT_MANAGER" / "APPROVING_MANAGER"
  roleKey String

  assignedToId String?
  // PENDING | APPROVED | REJECTED
  decision   String    @default("PENDING")
  signedName String?
  comment    String?
  decidedAt  DateTime?

  moc        Moc   @relation(fields: [mocId], references: [id], onDelete: Cascade)
  assignedTo User? @relation(fields: [assignedToId], references: [id])

  @@index([mocId, stage])
  @@index([assignedToId, decision])
}

// A single answered checklist row. Templates live in src/lib/checklists.ts.
model ChecklistResponse {
  id    String @id @default(cuid())
  mocId String

  // FUNCTIONAL_REVIEW | SE_ASSESSMENT | DOC_CHECKLIST | CLOSEOUT | TRANSITION_PLAN
  kind     String
  itemKey  String
  category String?
  label    String

  // FUNCTIONAL_REVIEW / CLOSEOUT: YES | NO | NA.  SE_ASSESSMENT: CHECKED.
  answer  String?
  remarks String?

  // DOC_CHECKLIST: owner + phase (DETAILED_DESIGN | PRE_COMMISSIONING | PRE_CLOSEOUT)
  ownerId       String?
  requiredPhase String?
  completedAt   DateTime?
  completedById String?

  moc         Moc   @relation(fields: [mocId], references: [id], onDelete: Cascade)
  owner       User? @relation("ChecklistOwner", fields: [ownerId], references: [id])
  completedBy User? @relation("ChecklistCompleter", fields: [completedById], references: [id])

  @@unique([mocId, kind, itemKey])
  @@index([mocId, kind])
}

// Punch list / action tracker items (PSSR categories A/B/C or GENERAL).
model ActionItem {
  id          String    @id @default(cuid())
  mocId       String
  description String
  category    String    @default("GENERAL") // A | B | C | GENERAL
  ownerId     String?
  dueDate     DateTime?
  status      String    @default("OPEN") // OPEN | CLOSED
  closedAt    DateTime?
  createdAt   DateTime  @default(now())

  moc   Moc   @relation(fields: [mocId], references: [id], onDelete: Cascade)
  owner User? @relation("ActionOwner", fields: [ownerId], references: [id])

  @@index([mocId, status])
}

model Attachment {
  id           String   @id @default(cuid())
  mocId        String
  filename     String
  storedName   String
  size         Int
  uploadedById String
  createdAt    DateTime @default(now())

  moc        Moc  @relation(fields: [mocId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id])
}

// MOC Addendum (Appendix G): scoped change to an approved MOC, TA approval.
model Addendum {
  id             String    @id @default(cuid())
  mocId          String
  summary        String
  technicalBasis String
  seAssessment   String?
  createdById    String
  approverId     String?
  decision       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  signedName     String?
  comment        String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())

  moc       Moc   @relation(fields: [mocId], references: [id], onDelete: Cascade)
  createdBy User  @relation("AddendumCreator", fields: [createdById], references: [id])
  approver  User? @relation("AddendumApprover", fields: [approverId], references: [id])
}

// Temporary-change extension reviews (MOC Part 4B / MOOC Part 3B), max 3.
model ExtensionReview {
  id               String   @id @default(cuid())
  mocId            String
  number           Int
  assumptionsValid Boolean
  extensionDate    DateTime
  comment          String?
  reviewedById     String
  signedName       String
  createdAt        DateTime @default(now())

  moc        Moc  @relation(fields: [mocId], references: [id], onDelete: Cascade)
  reviewedBy User @relation(fields: [reviewedById], references: [id])

  @@unique([mocId, number])
}

// Safety system bypass shift log (Day/Night initials while bypass is active).
model BypassLogEntry {
  id        String   @id @default(cuid())
  mocId     String
  date      DateTime
  shift     String // DAY | NIGHT
  initials  String
  userId    String
  createdAt DateTime @default(now())

  moc  Moc  @relation(fields: [mocId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

model AuditEntry {
  id        String   @id @default(cuid())
  mocId     String?
  userId    String?
  action    String
  detail    String?
  createdAt DateTime @default(now())

  moc  Moc?  @relation(fields: [mocId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([mocId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  mocId     String?
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}
