# ── Required ────────────────────────────────────────────────────────────────
# SQLite database file (inside the data volume in Docker)
DATABASE_URL="file:./data/moc.db"

# Random secret for session cookies — generate with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

# ── First administrator (used once by `npm run db:seed`) ───────────────────
ADMIN_EMAIL="ehs.director@yourcompany.com"
ADMIN_NAME="EHS Director"
ADMIN_PASSWORD="pick-a-strong-password"

# First site created by the seed
SITE_CODE="GUR"
SITE_NAME="Gurnee"

# ── Optional ────────────────────────────────────────────────────────────────
# Where uploaded attachments are stored (default: ./data/uploads)
# UPLOAD_DIR="/app/data/uploads"

# Base URL used in email links
# APP_URL="https://moc.yourcompany.com"

# SMTP for email notifications (in-app notifications always work without this)
# SMTP_HOST="smtp.yourcompany.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="moc@yourcompany.com"
# SMTP_SECURE="0"

# Set to 1 only if serving over plain HTTP inside a trusted network
# (allows the session cookie without HTTPS)
# INSECURE_COOKIES="1"
